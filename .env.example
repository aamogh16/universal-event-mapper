# --- Klaviyo (required for live event delivery) -----------------------------
# Settings -> Account -> API Keys -> Create Private API Key
# Needs scopes: events:write, profiles:write, events:read
KLAVIYO_PRIVATE_API_KEY=pk_replace_me

# Set to true to print the exact HTTP request without sending it.
# Useful for rehearsing the demo offline.
KLAVIYO_DRY_RUN=false

# --- Gemini (optional) ------------------------------------------------------
# https://aistudio.google.com/apikey  (free tier, no credit card)
# Leave blank: the mapper falls back to the deterministic inference engine,
# which needs no network and no key.
GEMINI_API_KEY=

# Model used to infer a mapping for an unknown payload (needs reasoning).
GEMINI_MAPPING_MODEL=gemini-3.8-flash

# Model used by the proactive agent. Deliberately the cheapest available --
# the point of Part 2 is that this task needs good context, not a big model.
GEMINI_AGENT_MODEL=gemini-3.5-flash-lite

# --- OpenAI (primary LLM provider) ------------------------------------------
# platform.openai.com/api-keys
# gpt-5-nano: $0.05/1M in, $0.40/1M out, $0.005/1M cached.
# Tier 1 gives 500 RPM, which is why this is the primary over Gemini's 10 RPM.
OPENAI_API_KEY=

# Model for flow audits and patch proposals.
OPENAI_AUDIT_MODEL=gpt-5.4-mini

# Which provider the auditor uses: openai | gemini | rules
# "rules" forces the deterministic auditor -- no network, always works.
LLM_PROVIDER=openai

# --- Demo controls ----------------------------------------------------------
# Production would be 86400 (daily). 60 lets you watch the sweep fire on stage.
SWEEP_INTERVAL_SECONDS=60

# Replay recorded LLM responses instead of calling out. Zero-network demo.
REHEARSE_MODE=false

# Run the recurring sweep on a background thread at startup.
AUTO_SWEEP=true

# --- Campaigns ---
# Approving a campaign creates a REAL Klaviyo campaign in Draft status.
# Nothing is ever sent (send-jobs is deliberately not implemented).
CREATE_REAL_CAMPAIGNS=true
CAMPAIGN_FROM_EMAIL=
CAMPAIGN_FROM_LABEL=Klaviyo Composer Demo

# Which business the demo is about. "" shows every seeded vertical.
DEMO_VERTICAL=fitness
