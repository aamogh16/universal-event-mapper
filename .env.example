# --- Klaviyo (required for live event delivery) -----------------------------
# Settings -> Account -> API Keys -> Create Private API Key
# Needs scopes: events:write, profiles:write, events:read
KLAVIYO_PRIVATE_API_KEY=pk_replace_me

# Set to true to print the exact HTTP request without sending it.
# Useful for rehearsing the demo offline.
KLAVIYO_DRY_RUN=false

# --- Gemini (optional) ------------------------------------------------------
# https://aistudio.google.com/apikey  (free tier, no credit card)
# Leave blank: the mapper falls back to the deterministic inference engine,
# which needs no network and no key.
GEMINI_API_KEY=

# Model used to infer a mapping for an unknown payload (needs reasoning).
GEMINI_MAPPING_MODEL=gemini-3.8-flash

# Model used by the proactive agent. Deliberately the cheapest available --
# the point of Part 2 is that this task needs good context, not a big model.
GEMINI_AGENT_MODEL=gemini-3.5-flash-lite
