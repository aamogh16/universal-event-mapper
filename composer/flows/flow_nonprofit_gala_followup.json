{
  "id": "flow_nonprofit_gala_followup",
  "name": "Gala RSVP Follow-Up",
  "vertical": "nonprofit",
  "business": "Harborlight Youth Coalition",
  "status": "live",
  "version": 1,
  "trigger": {
    "type": "metric",
    "metric": "Event RSVP"
  },
  "steps": [
    {
      "id": "s1",
      "type": "delay",
      "hours": 24
    },
    {
      "id": "s2",
      "type": "email",
      "subject": "Thanks for your RSVP",
      "body": "Dear {{ first_name }}, we are delighted you will join us at the Harborlight Annual Gala.",
      "cta": "View event details"
    },
    {
      "id": "s3",
      "type": "split",
      "condition": {
        "field": "ticket_level",
        "op": "equals",
        "value": "Table Host"
      },
      "true_branch": [],
      "false_branch": []
    }
  ],
  "handles_signals": []
}
